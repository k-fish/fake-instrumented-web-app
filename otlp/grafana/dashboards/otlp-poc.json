{
  "uid": "otlp-poc",
  "title": "OTLP PoC: Prometheus reference",
  "tags": ["otlp-poc"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "http.server.request.duration p50 / p95 / p99 (explicit buckets)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "mean"] } },
      "targets": [
        {
          "refId": "p50",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_milliseconds_bucket[1m])))",
          "legendFormat": "p50",
          "exemplar": true
        },
        {
          "refId": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_milliseconds_bucket[1m])))",
          "legendFormat": "p95",
          "exemplar": true
        },
        {
          "refId": "p99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_milliseconds_bucket[1m])))",
          "legendFormat": "p99",
          "exemplar": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "http.server.request.duration.exp p50 / p95 / p99 (native / exponential histogram)",
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "mean"] } },
      "targets": [
        { "refId": "p50", "expr": "histogram_quantile(0.5, sum(rate(http_server_request_duration_exp_milliseconds[1m])))", "legendFormat": "p50" },
        { "refId": "p95", "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_exp_milliseconds[1m])))", "legendFormat": "p95" },
        { "refId": "p99", "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_exp_milliseconds[1m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "poc.requests rate (req/s)",
      "gridPos": { "x": 0, "y": 17, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(poc_requests_total[1m]))", "legendFormat": "all routes" },
        { "refId": "B", "expr": "sum by (http_route) (rate(poc_requests_total[1m]))", "legendFormat": "{{http_route}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "poc.queue_depth (gauge)",
      "gridPos": { "x": 12, "y": 17, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] } },
      "targets": [
        { "refId": "A", "expr": "poc_queue_depth", "legendFormat": "{{queue_name}}" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Fixture: count / sum / p50 / p95 / p99 (cumulative series, no rate)",
      "gridPos": { "x": 0, "y": 25, "w": 24, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" },
      "targets": [
        { "refId": "count", "expr": "http_server_request_duration_milliseconds_count{http_route=\"/fixture\"}", "legendFormat": "count", "instant": true },
        { "refId": "sum", "expr": "http_server_request_duration_milliseconds_sum{http_route=\"/fixture\"}", "legendFormat": "sum", "instant": true },
        { "refId": "p50", "expr": "histogram_quantile(0.5, sum by (le) (http_server_request_duration_milliseconds_bucket{http_route=\"/fixture\"}))", "legendFormat": "p50", "instant": true },
        { "refId": "p95", "expr": "histogram_quantile(0.95, sum by (le) (http_server_request_duration_milliseconds_bucket{http_route=\"/fixture\"}))", "legendFormat": "p95", "instant": true },
        { "refId": "p99", "expr": "histogram_quantile(0.99, sum by (le) (http_server_request_duration_milliseconds_bucket{http_route=\"/fixture\"}))", "legendFormat": "p99", "instant": true },
        { "refId": "counter", "expr": "poc_fixture_counter_total", "legendFormat": "poc.fixture.counter", "instant": true }
      ]
    }
  ]
}
