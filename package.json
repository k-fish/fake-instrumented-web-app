{
  "name": "fake-instrumented-web-app",
  "version": "0.1.0",
  "homepage": "https://k-fish.github.io/fake-instrumented-web-app/",
  "private": true,
  "type": "module",
  "dependencies": {
    "@sentry/browser": "10.19.0",
    "@sentry/core": "10.19.0",
    "@sentry/node": "10.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "jsdom": "^25.0.1",
    "oxlint": "^0.15.0",
    "vite": "^6.0.1",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"node api/server.mjs\" \"npm --prefix otlp/app start\"",
    "dev:frontend": "vite",
    "dev:api": "node api/server.mjs",
    "dev:otlp": "npm --prefix otlp/app start",
    "otlp:fixture": "npm --prefix otlp/app run fixture",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "oxlint"
  }
}
